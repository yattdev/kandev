+++ b/scripts/kandev-agent-docker-broker
@@ -91,0 +92,3 @@ NETWORK_SLOT_POOL = ipaddress.IPv4Network("198.18.0.0/15")
+# Reviewed dependency for the read-only Coordinator launch proof. Updating the
+# worker requires requalifying this capability; no unpinned validator fallback.
+TASK_LIFECYCLE_LAUNCH_SHA256 = "6a09ebeb96429f955546cf8b30616cd287cf92fe36156ea54f7d7b843ad78a96"
@@ -2220,0 +2224 @@ def workspace_help() -> str:
