@@ -0,0 +1,274 @@
+#!/usr/bin/env python3
+"""Synthetic metadata/launch acceptance; never connects to a live broker or DB."""
+import hashlib
+import importlib.machinery
+import importlib.util
+import json
+import os
+from pathlib import Path
+import runpy
+import socket
+import sqlite3
+import tempfile
+import unittest
+from unittest import mock
+import uuid
+
+ROOT = Path(__file__).resolve().parents[1]
+loader = importlib.machinery.SourceFileLoader('lifecycle_broker', str(ROOT / 'scripts/kandev-agent-docker-broker'))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+broker = importlib.util.module_from_spec(spec)
+loader.exec_module(broker)
+worker_path = ROOT / 'scripts/kandev-test-worker.py'
+VALIDATOR = runpy.run_path(str(worker_path))
+VALIDATOR_HASH = hashlib.sha256(worker_path.read_bytes()).hexdigest()
+
+
+def uid(number):
+    return str(uuid.UUID(int=number))
+
+
+class LifecycleTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix='kandev-lifecycle-test-')
+        self.addCleanup(self.temporary.cleanup)
+        self.base = Path(self.temporary.name)
+        self.root = Path('/data/tasks/coordinator-lifecycle-inert')  # lexical fixture, never created
+        self.database = self.base / 'fixture.db'
+        with sqlite3.connect(self.database) as db:
+            db.executescript('''
+                CREATE TABLE workspaces(id TEXT PRIMARY KEY, name TEXT, owner_id TEXT);
+                CREATE TABLE tasks(id TEXT PRIMARY KEY, workspace_id TEXT, archived_at TEXT,
+                    workflow_id TEXT, workflow_step_id TEXT, state TEXT, updated_at TEXT);
+                CREATE TABLE task_plans(task_id TEXT PRIMARY KEY, content TEXT);
+                CREATE TABLE task_environments(id TEXT, task_id TEXT, workspace_path TEXT,
+                    task_dir_name TEXT, status TEXT, ownership_generation INTEGER);
+                CREATE TABLE task_sessions(id TEXT, task_id TEXT, task_environment_id TEXT,
+                    state TEXT, queue_incarnation_id TEXT, workspace_path TEXT);
+                CREATE TABLE executors_running(task_id TEXT, session_id TEXT, agent_execution_id TEXT,
+                    pid INTEGER, local_pid INTEGER, status TEXT, runtime TEXT, worktree_path TEXT, metadata TEXT);
+                CREATE TABLE repositories(id TEXT, workspace_id TEXT, local_path TEXT, deleted_at TEXT);
+                CREATE TABLE task_repositories(task_id TEXT, repository_id TEXT);
+            ''')
+            db.executemany('INSERT INTO workspaces VALUES(?,?,?)', [
+                (uid(1), 'own', 'user-a'), (uid(2), 'foreign same owner', 'user-a'),
+                (uid(3), 'foreign other owner', 'user-b')])
+            db.executemany('INSERT INTO tasks VALUES(?,?,?,?,?,?,?)', [
+                (uid(10), uid(1), None, uid(100), uid(101), 'IN_PROGRESS', '2026-11-25T00:00:00Z'),
+                (uid(11), uid(1), None, uid(100), uid(101), 'CREATED', '2026-11-25T00:00:00Z'),
+                (uid(12), uid(1), '2026-11-24T00:00:00Z', uid(100), uid(102), 'COMPLETED', '2026-11-24T00:00:00Z'),
+                (uid(13), uid(2), None, uid(200), uid(201), 'CREATED', '2026-11-25T00:00:00Z'),
+                (uid(14), uid(3), None, uid(300), uid(301), 'CREATED', '2026-11-25T00:00:00Z')])
+            db.execute('INSERT INTO task_plans VALUES(?,?)', (uid(12), 'synthetic-retained-plan-must-not-be-read'))
+            db.execute('INSERT INTO task_environments VALUES(?,?,?,?,?,?)',
+                       (uid(20), uid(10), str(self.root), self.root.name, 'ready', 1))
+            db.execute('INSERT INTO task_sessions VALUES(?,?,?,?,?,?)',
+                       (uid(30), uid(10), uid(20), 'RUNNING', uid(40), str(self.root)))
+            db.execute('INSERT INTO executors_running VALUES(?,?,?,?,?,?,?,?,?)',
+                       (uid(10), uid(30), uid(50), os.getpid(), os.getpid(), 'running', 'standalone', str(self.root), '{}'))
+            db.execute('INSERT INTO repositories VALUES(?,?,?,NULL)', (uid(60), uid(1), broker.COORDINATOR_REPOSITORY))
+            db.execute('INSERT INTO task_repositories VALUES(?,?)', (uid(10), uid(60)))
+        for name, value in (
+            ('KANDEV_DB', self.database), ('COORDINATOR_AUDIT_LOG', self.base / 'audit.jsonl'),
+        ):
+            patch = mock.patch.object(broker, name, value)
+            patch.start()
+            self.addCleanup(patch.stop)
+        # Only development file custody is substituted: policy, real SQL,
+        # registered root/session matching and kernel process ancestry are real.
+        self.assertEqual(VALIDATOR_HASH, broker.TASK_LIFECYCLE_LAUNCH_SHA256)
+        self.validator = dict(VALIDATOR)
+        kernel_process = VALIDATOR['process']
+        def fixture_process(pid):
+            if pid != os.getpid():
+                raise VALIDATOR['WorkerError']('peer is outside the synthetic process fixture')
+            # Keep the real kernel PID/start/executable/namespaces, but end
+            # the synthetic ancestry at this fixture's launch. Do not inspect
+            # the host test runner's unrelated parent processes.
+            return {**kernel_process(pid), 'ppid': 0}
+        process_patch = mock.patch.dict(VALIDATOR['ancestry'].__globals__, {'process': fixture_process})
+        process_patch.start()
+        self.addCleanup(process_patch.stop)
+        self.validator['process'] = fixture_process
+        custody = mock.patch.object(broker, 'load_worker_control', return_value=(self.validator, VALIDATOR_HASH))
+        custody.start()
+        self.addCleanup(custody.stop)
+        commands = mock.patch.object(broker, 'run_command', side_effect=AssertionError('unexpected daemon/process command'))
+        self.commands = commands.start()
+        self.addCleanup(commands.stop)
+        self.target_reads = mock.patch.object(broker, 'lifecycle_target', wraps=broker.lifecycle_target).start()
+        self.addCleanup(mock.patch.stopall)
+
+    def execute(self, task=11, peer=None):
+        return broker.handle_task_lifecycle(self.root, [uid(task)], os.getpid() if peer is None else peer)
+
+    def code(self, result):
+        self.assertEqual(result['returncode'], 78)
+        return json.loads(result['stdout'])['error']['code']
+
+    def sql(self, statement, parameters=()):
+        with sqlite3.connect(self.database) as db:
+            db.execute(statement, parameters)
+
+    def snapshot(self):
+        with sqlite3.connect(self.database) as db:
+            return '\n'.join(db.iterdump())
+
+    def tearDown(self):
+        self.commands.assert_not_called()
+
+    def test_active_planless_read_is_bounded_and_database_unchanged(self):
+        before = self.snapshot()
+        result = self.execute()
+        self.assertEqual(result['returncode'], 0)
+        data = json.loads(result['stdout'])
+        self.assertEqual(data['lifecycle'], 'active')
+        self.assertEqual(data['workspace_id'], uid(1))
+        self.assertEqual(data['plan'], {'status': 'absent', 'code': 'PLAN_NOT_FOUND'})
+        self.assertLessEqual(len(result['stdout'].encode()), 4096)
+        self.assertEqual(before, self.snapshot())
+
+    def test_archived_plan_is_retained_without_content_exposure(self):
+        before = self.snapshot()
+        result = self.execute(12)
+        data = json.loads(result['stdout'])
+        self.assertEqual(data['lifecycle'], 'archived')
+        self.assertEqual(data['archived_at'], '2026-11-24T00:00:00Z')
+        self.assertEqual(data['plan'], {'status': 'present', 'code': None})
+        self.assertNotIn('synthetic-retained-plan', result['stdout'])
+        self.assertNotIn('content', result['stdout'])
+        self.assertEqual(before, self.snapshot())
+
+    def test_missing_and_both_foreign_workspaces_are_identically_masked(self):
+        missing = self.execute(999)
+        self.assertEqual(self.code(missing), 'TASK_NOT_FOUND_OR_INACCESSIBLE')
+        self.assertEqual(json.loads(missing['stdout'])['error']['deletion_evidence'], 'unproven')
+        self.assertEqual(self.execute(13), missing)
+        self.assertEqual(self.execute(14), missing)
+
+    def test_unknown_peer_is_denied_before_target_query(self):
+        for peer in (None, 0, -1, '1', True, 999999999):
+            result = broker.handle_task_lifecycle(self.root, [uid(11)], peer)
+            self.assertEqual(self.code(result), 'ACCESS_DENIED')
+        self.target_reads.assert_not_called()
+
+    def test_malformed_target_or_identity_override_is_rejected(self):
+        for args in ([], ['not-a-uuid'], [uid(11), '--session-id', uid(30)]):
+            self.assertEqual(self.code(broker.handle_task_lifecycle(self.root, args, os.getpid())), 'INVALID_ARGUMENT')
+        self.target_reads.assert_not_called()
+
+    def test_ordinary_task_is_denied_before_target_query(self):
+        self.sql('UPDATE repositories SET local_path=?', ('/data/home/Code/ordinary',))
+        self.assertEqual(self.code(self.execute()), 'ACCESS_DENIED')
+        self.target_reads.assert_not_called()
+
+    def test_other_launch_pid_is_denied_before_target_query(self):
+        self.sql('UPDATE executors_running SET pid=999999999,local_pid=999999999')
+        self.assertEqual(self.code(self.execute()), 'ACCESS_DENIED')
+        self.target_reads.assert_not_called()
+
+    def test_revoked_session_is_denied_before_target_query(self):
+        self.sql("UPDATE task_sessions SET state='COMPLETED'")
+        self.assertEqual(self.code(self.execute()), 'ACCESS_DENIED')
+        self.target_reads.assert_not_called()
+
+    def test_wrong_session_environment_is_denied_before_target_query(self):
+        self.sql('UPDATE task_sessions SET task_environment_id=?', (uid(999),))
+        self.assertEqual(self.code(self.execute()), 'ACCESS_DENIED')
+        self.target_reads.assert_not_called()
+
+    def test_ambiguous_launch_is_denied_without_sole_session_fallback(self):
+        self.sql('INSERT INTO task_sessions SELECT ?,task_id,task_environment_id,state,?,workspace_path FROM task_sessions', (uid(31), uid(41)))
+        self.sql('INSERT INTO executors_running SELECT task_id,?,?,pid,local_pid,status,runtime,worktree_path,metadata FROM executors_running', (uid(31), uid(51)))
+        self.assertEqual(self.code(self.execute()), 'ACCESS_DENIED')
+        self.target_reads.assert_not_called()
+
+    def test_source_pin_drift_is_unavailable(self):
+        with mock.patch.object(broker, 'load_worker_control', return_value=(self.validator, '0' * 64)):
+            self.assertEqual(self.code(self.execute()), 'METADATA_UNAVAILABLE')
+        self.target_reads.assert_not_called()
+
+    def test_storage_fault_is_not_missing(self):
+        self.sql('DROP TABLE task_plans')
+        self.assertEqual(self.code(self.execute()), 'METADATA_UNAVAILABLE')
+
+    def test_caller_metadata_fault_is_unavailable_before_target_query(self):
+        self.sql('DROP TABLE executors_running')
+        self.assertEqual(self.code(self.execute()), 'METADATA_UNAVAILABLE')
+        self.target_reads.assert_not_called()
+
+    def test_validator_custody_failure_is_unavailable(self):
+        with mock.patch.object(broker, 'load_worker_control', side_effect=broker.BrokerError('custody differs')):
+            self.assertEqual(self.code(self.execute()), 'METADATA_UNAVAILABLE')
+        self.target_reads.assert_not_called()
+
+    def test_incarnation_change_during_read_discards_result(self):
+        original = broker.lifecycle_target
+        def change(*args):
+            result = original(*args)
+            self.sql('UPDATE task_sessions SET queue_incarnation_id=?', (uid(42),))
+            return result
+        with mock.patch.object(broker, 'lifecycle_target', side_effect=change):
+            self.assertEqual(self.code(self.execute()), 'ACCESS_DENIED')
