@@ -2492,0 +2497,95 @@ fi
+def lifecycle_error(code: str) -> dict[str, Any]:
+    error: dict[str, Any] = {"code": code}
+    if code == "TASK_NOT_FOUND_OR_INACCESSIBLE":
+        error["deletion_evidence"] = "unproven"
+    return {"returncode": 78, "stdout": json.dumps({
+        "schema": "task-lifecycle/v1", "error": error,
+    }, sort_keys=True) + "\n", "stderr": f"kandev-agent-docker: {code}\n"}
+
+
+def lifecycle_peer_identity(validator: dict[str, Any], peer_pid: int) -> tuple[Any, ...]:
+    process = validator["process"](peer_pid)
+    executable = process["exe"]
+    return (process["pid"], process["start"], process["mnt"], process["pidns"],
+            process["userns"], executable.st_dev, executable.st_ino)
+
+
+def lifecycle_caller(task_root: Path, peer_pid: int, validator: dict[str, Any]) -> dict[str, Any]:
+    # The kernel peer's ancestry must contain the exact registered launch.
+    # Never use request identity hints, registration mode or a sole-session
+    # fallback when the peer itself cannot be authenticated.
+    owner = validator["metadata"](
+        KANDEV_DB, task_root, ancestors=validator["ancestry"](peer_pid),
+    )
+    coordinator = coordinator_context(task_root)
+    if any(owner[key] != coordinator[key] for key in ("task_id", "workspace_id")):
+        raise BrokerError("Coordinator launch differs from its registration")
+    return {**owner, "workspace_name": coordinator["workspace_name"]}
+
+
+def lifecycle_target(workspace_id: str, task_id: str) -> dict[str, Any] | None:
+    with kandev_db() as database:
+        database.execute("BEGIN")
+        row = database.execute("""
+            SELECT t.id, t.workspace_id, t.workflow_id, t.workflow_step_id,
+                   t.state, t.updated_at, t.archived_at,
+                   EXISTS(SELECT 1 FROM task_plans p WHERE p.task_id=t.id) AS has_plan
+            FROM tasks t WHERE t.id=? AND t.workspace_id=?
+        """, (task_id, workspace_id)).fetchone()
+    if row is None:
+        return None
+    return {
+        "schema": "task-lifecycle/v1", "task_id": row["id"],
+        "workspace_id": row["workspace_id"], "state": row["state"],
+        "workflow_id": row["workflow_id"], "workflow_step_id": row["workflow_step_id"],
+        "updated_at": row["updated_at"], "archived_at": row["archived_at"],
+        "lifecycle": "archived" if row["archived_at"] is not None else "active",
+        "plan": {"status": "present" if row["has_plan"] else "absent",
+                 "code": None if row["has_plan"] else "PLAN_NOT_FOUND"},
+    }
+
+
+def handle_task_lifecycle(task_root: Path, args: list[str], peer_pid: int | None) -> dict[str, Any]:
+    if len(args) != 1 or not TASK_ID_RE.fullmatch(args[0]):
+        return lifecycle_error("INVALID_ARGUMENT")
+    if type(peer_pid) is not int or peer_pid <= 0:
+        return lifecycle_error("ACCESS_DENIED")
+    try:
+        validator, digest = load_worker_control(Path(__file__).with_name("kandev-test-worker.py"))
+        if digest != TASK_LIFECYCLE_LAUNCH_SHA256:
+            return lifecycle_error("METADATA_UNAVAILABLE")
+    except (BrokerError, OSError, ValueError):
+        return lifecycle_error("METADATA_UNAVAILABLE")
+    try:
+        peer = lifecycle_peer_identity(validator, peer_pid)
+        caller = lifecycle_caller(task_root, peer_pid, validator)
+    except (OSError, sqlite3.Error):
+        return lifecycle_error("METADATA_UNAVAILABLE")
+    except (BrokerError, RuntimeError, ValueError, KeyError):
+        return lifecycle_error("ACCESS_DENIED")
+    try:
+        target = lifecycle_target(caller["workspace_id"], args[0])
+        output = json.dumps(target, sort_keys=True) + "\n"
+        if len(output.encode()) > 4096:
+            return lifecycle_error("METADATA_UNAVAILABLE")
+    except (OSError, sqlite3.Error, ValueError, TypeError):
+        return lifecycle_error("METADATA_UNAVAILABLE")
+    try:
+        if (lifecycle_caller(task_root, peer_pid, validator) != caller
+                or lifecycle_peer_identity(validator, peer_pid) != peer):
+            return lifecycle_error("ACCESS_DENIED")
+    except (OSError, sqlite3.Error):
+        return lifecycle_error("METADATA_UNAVAILABLE")
+    except (BrokerError, RuntimeError, ValueError, KeyError):
+        return lifecycle_error("ACCESS_DENIED")
+    try:
+        audit_source(caller, "task-lifecycle", target_task_id=args[0],
+                     session_id=caller["session_id"], execution_id=caller["execution_id"],
+                     result="ok" if target is not None else "not-found-or-inaccessible")
+    except (BrokerError, OSError, ValueError):
+        return lifecycle_error("METADATA_UNAVAILABLE")
+    if target is None:
+        return lifecycle_error("TASK_NOT_FOUND_OR_INACCESSIBLE")
+    return {"returncode": 0, "stdout": output, "stderr": ""}
+
+
@@ -2881,0 +2981,2 @@ def handle_request(
+    if args[:3] == ["kandev", "workspace", "task-lifecycle"]:
+        return handle_task_lifecycle(task_root, args[3:], peer_pid)
