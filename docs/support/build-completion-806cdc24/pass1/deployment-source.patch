+def capture_directory(broker, root, cwd):
+    owner = hashlib.sha256(str(root).encode()).hexdigest()
+    clone = hashlib.sha256(str(cwd).encode()).hexdigest()
+    directory = broker.MODEL_DIR / owner / 'successful-builds' / clone
+    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+    return directory
+
+
+@contextlib.contextmanager
+def build_receipt_lock(broker, root, cwd, image):
+    directory = capture_directory(broker, root, cwd)
+    path = directory / ('.lock-' + hashlib.sha256(image.encode()).hexdigest())
+    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022 or info.st_nlink != 1:
+            raise broker.BrokerError('BUILD_CAPTURE_UNAVAILABLE: invalid receipt lock')
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise broker.BrokerError('BUILD_CAPTURE_BUSY: another output operation holds this tag; do not retry automatically') from None
+        yield directory
+    finally:
+        os.close(fd)
+
+
+def record_successful_build_output(broker, task_root, cwd, project, service, image):
+    # Serialize the existing standalone writer with the stricter Compose writer.
+    with build_receipt_lock(broker, task_root, cwd, image):
+        _record_successful_build_output_unlocked(broker, task_root, cwd, project, service, image)
+
+
+def capture_json_bytes(value):
+    return (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode()
+
+
+def capture_read(broker, path, limit=131072, absent=False):
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    except FileNotFoundError:
+        if absent:
+            return None
+        raise
+    with os.fdopen(fd, 'rb') as stream:
+        before = os.fstat(stream.fileno())
+        stamp = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+        if not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid() or before.st_mode & 0o022 or before.st_nlink != 1:
+            raise broker.BrokerError('BUILD_CAPTURE_UNAVAILABLE: invalid private record custody')
+        value = stream.read(limit + 1)
+        if len(value) > limit or stamp(before) != stamp(os.fstat(stream.fileno())) or stamp(before) != stamp(path.stat(follow_symlinks=False)):
+            raise broker.BrokerError('BUILD_CAPTURE_UNAVAILABLE: unstable or oversized private record')
+        return value
+
+
+def capture_write(broker, path, value, expected):
+    # All receipt writers use the same tag lock. CAS also detects an external
+    # change; it never replaces an unexpected receipt or pending operation.
+    if capture_read(broker, path, absent=True) != expected:
+        raise broker.BrokerError('BUILD_CAPTURE_CONFLICT: private record changed; stop before retry')
+    fd, temporary = tempfile.mkstemp(prefix='.capture-', dir=path.parent)
+    try:
+        with os.fdopen(fd, 'wb') as stream:
+            stream.write(capture_json_bytes(value)); stream.flush(); os.fsync(stream.fileno())
+        if capture_read(broker, path, absent=True) != expected:
+            raise broker.BrokerError('BUILD_CAPTURE_CONFLICT: private record changed; stop before retry')
+        if expected is None:
+            # Atomic create-if-absent, including a writer that does not take
+            # our lock. Never overwrite an existing historical receipt.
+            os.link(temporary, path, follow_symlinks=False)
+            Path(temporary).unlink()
+        else:
+            os.replace(temporary, path)
+        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+    finally:
+        Path(temporary).unlink(missing_ok=True)
+
+
+class ComposeBuildCapture:
