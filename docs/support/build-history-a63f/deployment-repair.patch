+  target=pathlib.Path('/usr/local/bin')/name;shutil.copyfile('/fixture-inputs/'+name,target);target.chmod(0o555)
+os.execv('/usr/bin/python3',['python3','-I',str(p),'--isolated',*sys.argv[1:]])
+'''
+    argv=['bwrap','--unshare-user','--uid','0','--gid','0','--unshare-net','--tmpfs','/',
+          '--ro-bind','/usr','/usr','--ro-bind','/lib','/lib','--ro-bind','/lib64','/lib64',
+          '--ro-bind','/bin','/bin','--ro-bind','/proc','/proc','--dev','/dev','--dir','/etc',
+          '--ro-bind','/etc/ld.so.cache','/etc/ld.so.cache','--dir','/run','--dir','/tmp',
+          '--die-with-parent','--clearenv','--setenv','PATH','/usr/local/bin:/usr/bin:/bin','--chdir','/tmp',
+          '--ro-bind',str(ROOT/'tests/test-fresh-build-bootstrap.py'),'/tmp/test-fresh-build-bootstrap.py']
